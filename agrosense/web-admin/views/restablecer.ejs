<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# la URL lleva el token: que no viaje en el Referer a la CDN de los íconos %>
  <meta name="referrer" content="no-referrer">
  <title>AgroSense - Nueva contraseña</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/ver-password.js" defer></script>
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="bi bi-shield-lock-fill"></i></div>
    <h1>Nueva contraseña</h1>
    <p class="auth-subtitle">Mínimo <%= minimo %> caracteres. El enlace solo se puede usar una vez.</p>

    <% if (error) { %>
      <p class="auth-message auth-message--error"><%= error %></p>
    <% } %>

    <% if (!token) { %>
      <p class="auth-message auth-message--error">Falta el código de recuperación en el enlace.</p>
      <p class="auth-link"><a href="/olvide">Solicitar un enlace nuevo</a></p>
    <% } else { %>
      <form method="POST" action="/restablecer">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="input-icon-group">
          <i class="bi bi-lock-fill"></i>
          <input type="password" name="password" placeholder="Contraseña nueva" minlength="<%= minimo %>" required autocomplete="new-password">
        </div>
        <div class="input-icon-group">
          <i class="bi bi-lock-fill"></i>
          <input type="password" name="confirmacion" placeholder="Repite la contraseña" minlength="<%= minimo %>" required autocomplete="new-password">
        </div>
        <button type="submit">Guardar contraseña</button>
      </form>
      <p class="auth-link">¿El enlace venció? <a href="/olvide">Solicita uno nuevo</a></p>
    <% } %>
  </div>
</body>
</html>
