<aside class="sidebar">
  <div class="sidebar-brand">
    <i class="bi bi-flower2"></i>
    <span>AgroSense</span>
  </div>
  <nav class="sidebar-nav">
    <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">
      <i class="bi bi-grid-1x2-fill"></i> Dashboard
    </a>
    <a href="/fincas" class="<%= active === 'fincas' ? 'active' : '' %>">
      <i class="bi bi-house-door-fill"></i> Fincas
    </a>
    <a href="/parcelas" class="<%= active === 'parcelas' ? 'active' : '' %>">
      <i class="bi bi-map-fill"></i> Parcelas
    </a>
    <a href="/cultivos" class="<%= active === 'cultivos' ? 'active' : '' %>">
      <i class="bi bi-flower1"></i> Cultivos
    </a>
    <a href="/riego" class="<%= active === 'riego' ? 'active' : '' %>">
      <i class="bi bi-droplet-half"></i> Riego
    </a>
    <a href="/sensores" class="<%= active === 'sensores' ? 'active' : '' %>">
      <i class="bi bi-broadcast"></i> Sensores
    </a>
    <a href="/lecturas" class="<%= active === 'lecturas' ? 'active' : '' %>">
      <i class="bi bi-activity"></i> Lecturas en vivo
    </a>
    <a href="/alertas" class="<%= active === 'alertas' ? 'active' : '' %>">
      <i class="bi bi-bell-fill"></i> Alertas
      <span class="menu-badge" id="insignia-alertas" hidden title="Alertas activas sin atender"></span>
    </a>
    <% if (usuario && usuario.rol === 'admin') { %>
      <a href="/usuarios" class="<%= active === 'usuarios' ? 'active' : '' %>">
        <i class="bi bi-people-fill"></i> Usuarios
      </a>
      <a href="/respaldos" class="<%= active === 'respaldos' ? 'active' : '' %>">
        <i class="bi bi-database-fill-lock"></i> Respaldos
      </a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <a href="/configuracion" class="sidebar-user <%= active === 'configuracion' ? 'active' : '' %>">
      <% if (usuario && usuario.foto_url) { %>
        <img class="sidebar-avatar" src="<%= usuario.foto_url %>" alt="">
      <% } else { %>
        <i class="bi bi-person-circle sidebar-avatar-fallback"></i>
      <% } %>
      <span><%= usuario && usuario.nombre ? usuario.nombre : (usuario && usuario.email) || 'Usuario' %></span>
    </a>
    <a href="/logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
  </div>
</aside>
<script>
  // En pantallas bajas el menú tiene su propio scroll: que se vea la opción de la página actual
  document.querySelector('.sidebar-nav a.active')?.scrollIntoView({ block: 'nearest' });

  // Insignia de alertas activas (sin atender) en el menú; se refresca cada 30 s
  (function () {
    const insignia = document.getElementById('insignia-alertas');
    async function actualizar() {
      try {
        const res = await fetch('/alertas/conteo', { headers: { Accept: 'application/json' } });
        if (!res.ok || !(res.headers.get('content-type') || '').includes('application/json')) return;
        const c = await res.json();
        insignia.hidden = c.activas === 0;
        insignia.textContent = c.activas > 99 ? '99+' : c.activas;
        insignia.classList.toggle('menu-badge--alta', c.por_severidad.alta > 0);
      } catch (e) { /* sin conexión: se reintenta */ }
    }
    actualizar();
    setInterval(actualizar, 30000);
  })();
</script>
