<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AgroSense - Recuperar contraseña</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="bi bi-key-fill"></i></div>
    <h1>Recuperar contraseña</h1>
    <p class="auth-subtitle">Escribe tu correo y te enviaremos un enlace para definir una contraseña nueva</p>

    <% if (error) { %>
      <p class="auth-message auth-message--error"><%= error %></p>
    <% } %>

    <% if (mensaje) { %>
      <p class="auth-message auth-message--success"><%= mensaje %></p>
      <% if (devEnlace) { %>
        <%# Solo con DEV_SHOW_RESET_TOKEN=true: en producción el enlace llegaría por correo %>
        <p class="auth-message">
          <strong>Modo desarrollo</strong> (no se envía correo):
          <a href="<%= devEnlace %>">abrir el enlace de recuperación</a>
        </p>
      <% } %>
      <p class="auth-link"><a href="/login">Volver a iniciar sesión</a></p>
    <% } else { %>
      <form method="POST" action="/olvide">
        <div class="input-icon-group">
          <i class="bi bi-envelope-fill"></i>
          <input type="email" name="email" placeholder="Correo electrónico" value="<%= email %>" required>
        </div>
        <button type="submit">Enviar enlace</button>
      </form>
      <p class="auth-link"><a href="/login">Volver a iniciar sesión</a></p>
    <% } %>
  </div>
</body>
</html>
