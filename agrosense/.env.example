# Copiar este archivo a .env (desarrollo) y .env.test (pruebas) y ajustar valores.
# NUNCA subir .env ni .env.test reales a Git (ya están en .gitignore).

# --- Base de datos ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=agrosense
DB_USER=agrosense_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- JWT / Auth ---
# Lo comparten auth-service (firma) y fincas, lecturas, simulator, backup y web-admin (verifican)
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h
# Token interno para llamadas entre microservicios (cabecera X-Service-Token). Genera uno con:
#   openssl rand -hex 32
SERVICE_TOKEN=cambia-este-token-interno

# --- Recuperación de contraseña (simulación: no se envía correo) ---
# El enlace/código siempre se escribe en los logs de auth-service (docker logs agrosense-auth).
# true = además se muestra en pantalla (web y app). Solo para desarrollo; en producción, false.
DEV_SHOW_RESET_TOKEN=false
# URL pública del panel web, para armar el enlace de recuperación
WEB_PUBLIC_URL=http://localhost:8080

# --- URLs internas entre microservicios (para desarrollo local con docker compose) ---
AUTH_SERVICE_URL=http://auth-service:3000
FINCAS_SERVICE_URL=http://fincas-service:3000
LECTURAS_SERVICE_URL=http://lecturas-service:3000

# --- Puerto interno de cada servicio (no confundir con el puerto publicado en docker-compose) ---
PORT=3000

# --- ETL ---
# Cada cuántos minutos se recalculan los resúmenes diarios (en desarrollo, docker-compose.yml usa 5)
ETL_INTERVAL_MINUTES=60

# --- Simulador de sensores (simulator-service) ---
# Segundos reales entre cada envío de lecturas (una por estación demo)
SIM_INTERVAL_SECONDS=10
# Aceleración del reloj simulado: 144 = un día simulado cada 10 minutos reales
SIM_TIME_SCALE=144
# Escenario inicial: normal | sequia | ola_calor | exceso_lluvia
SIM_SCENARIO=normal
# false = arranca pausado (se reanuda con POST /resume)
SIM_AUTOSTART=true
# Nombre con el que se identifica la finca demo (no usar el de una finca real)
SIM_FINCA_NOMBRE="Finca Demo (Simulador)"

# --- Motor de riego (fincas-service) ---
# Reloj del motor: "simulado" toma la hora acelerada del simulador (GET /reloj);
# "real" usa la hora local de APP_TIMEZONE (para cuando haya sensores reales)
RIEGO_RELOJ=simulado
SIMULATOR_SERVICE_URL=http://simulator-service:3000
# Zona horaria de las horas de riego y del arranque del reloj simulado
APP_TIMEZONE=America/Guatemala
# Duración (minutos del reloj del motor) de cada riego automático
RIEGO_AUTO_DURACION_MINUTOS=60
# Cada cuántos segundos reales revisa el motor (por defecto 5 con reloj simulado, 60 con real)
# RIEGO_TICK_SECONDS=5

# --- Clima y alertas (lecturas-service) ---
# Proveedor de clima (GET /clima). Por defecto el simulador (SIMULATOR_SERVICE_URL)
# CLIMA_PROVIDER_URL=http://simulator-service:3000
# Cada cuántos segundos se revisa el clima para abrir/resolver alertas climáticas
CLIMA_POLL_SECONDS=10
# Eventos de clima aleatorios en el simulador (lluvia, helada, ola de calor, viento)
SIM_CLIMA_ALEATORIO=true
SIM_CLIMA_EVENTOS_POR_DIA=1

# --- Respaldos (backup-service) ---
BACKUP_SERVICE_URL=http://backup-service:3000
# Cada cuántas horas se hace el respaldo automático
BACKUP_INTERVAL_HOURS=24
# Respaldos más viejos que esto se borran solos
BACKUP_RETENTION_DAYS=7
# true = hace un respaldo automático apenas arranca el servicio
BACKUP_ON_START=false
# Opcional: si se define, backup-service exige este valor en la cabecera x-backup-token
# (web-admin lo envía). Recomendado si el puerto 3005 queda expuesto fuera de tu PC.
# BACKUP_API_TOKEN=cambia_este_valor
