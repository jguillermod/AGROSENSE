# Copiar este archivo a .env (desarrollo o producción) y .env.test (pruebas) y ajustar valores.
# NUNCA subir .env ni .env.test reales a Git (ya están en .gitignore).
# Todos los valores de abajo son de EJEMPLO. En producción (DEPLOY.md) cada secreto
# se genera nuevo, largo y aleatorio, por ejemplo con:  openssl rand -hex 32

# --- Producción: dominio y HTTPS (docker-compose.prod.yml) ---
# Dominio del panel web y de las APIs de la app (su registro DNS apunta al servidor).
DOMINIO=agrosense.ejemplo.com
# Opcional: subdominio para Uptime Kuma (con su propio registro DNS). Vacío = no se publica.
KUMA_DOMINIO=
# Las cookies de sesión del panel solo viajan por HTTPS. docker-compose.prod.yml ya lo pone
# en true; en desarrollo (http://localhost) déjalo en false.
COOKIE_SECURE=false

# --- Base de datos ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=agrosense
DB_USER=agrosense_user
# En producción: openssl rand -hex 24 (cada una distinta)
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- JWT / Auth ---
# Lo comparten auth-service (firma) y fincas, lecturas, simulator, backup y web-admin (verifican)
# En producción: openssl rand -hex 32
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h
# Token interno para llamadas entre microservicios (cabecera X-Service-Token).
# En producción: openssl rand -hex 32
SERVICE_TOKEN=cambia-este-token-interno

# --- Recuperación de contraseña (sin servidor de correo: no se envía correo) ---
# El enlace/código siempre se escribe en los logs de auth-service (docker logs agrosense-auth).
# true = además se muestra en pantalla (web y app). Solo para desarrollo; en producción, false
# (docker-compose.prod.yml lo fuerza a false).
DEV_SHOW_RESET_TOKEN=false
# URL pública del panel web, para armar el enlace de recuperación.
# Desarrollo: http://localhost:8080 · Producción: https://<DOMINIO> (si se deja vacía, se usa esa)
WEB_PUBLIC_URL=http://localhost:8080

# --- URLs internas entre microservicios (para desarrollo local con docker compose) ---
AUTH_SERVICE_URL=http://auth-service:3000
FINCAS_SERVICE_URL=http://fincas-service:3000
LECTURAS_SERVICE_URL=http://lecturas-service:3000

# --- Puerto interno de cada servicio (no confundir con el puerto publicado en docker-compose) ---
PORT=3000

# --- ETL ---
# Cada cuántos minutos se recalculan los resúmenes diarios (en desarrollo, docker-compose.yml usa 5)
ETL_INTERVAL_MINUTES=60

# --- Servicio de estaciones (simulator-service) ---
# Alimenta las estaciones con código ESTACIONES_PREFIJO (los sensores físicos usan otro código).
# Sin SIM_INTERVAL_SECONDS, cada estación envía una lectura cada 30 a 60 s (al azar).
# SIM_INTERVAL_SECONDS=45
ESTACIONES_PREFIJO=AGS-
# Reloj: 1 = hora real (por defecto). Un valor mayor acelera el tiempo, solo para ensayar a mano.
SIM_TIME_SCALE=1
# Escenario inicial: normal | sequia | ola_calor | exceso_lluvia
SIM_SCENARIO=normal
# false = arranca pausado (se reanuda con POST /resume)
SIM_AUTOSTART=true
# Al arrancar rellena el hueco desde la última lectura guardada (máximo 7 días)
RELLENO_MAX_DIAS=7

# --- Motor de riego (fincas-service) ---
# Reloj del motor: "real" (por defecto) usa la hora local de APP_TIMEZONE;
# "simulado" toma la hora acelerada de simulator-service (GET /reloj), solo para ensayar
RIEGO_RELOJ=real
SIMULATOR_SERVICE_URL=http://simulator-service:3000
# Zona horaria de todas las horas que se muestran (Guatemala, UTC-6)
APP_TIMEZONE=America/Guatemala
# Duración (minutos) de cada riego automático
RIEGO_AUTO_DURACION_MINUTOS=60
# Cada cuántos segundos revisa el motor (por defecto 60 con reloj real, 5 con el acelerado)
# RIEGO_TICK_SECONDS=60

# --- Clima y alertas (lecturas-service) ---
# Proveedor de clima (GET /clima, un clima por finca). Por defecto simulator-service (SIMULATOR_SERVICE_URL)
# CLIMA_PROVIDER_URL=http://simulator-service:3000
# Cada cuántos segundos se revisa el clima para abrir/resolver alertas climáticas
CLIMA_POLL_SECONDS=10
# Eventos de clima aleatorios propios de cada finca (lluvias de tarde, heladas en fincas frías,
# olas de calor en las cálidas, viento), en promedio por día y por finca
SIM_CLIMA_ALEATORIO=true
SIM_CLIMA_EVENTOS_POR_DIA=0.5

# --- Respaldos (backup-service) ---
BACKUP_SERVICE_URL=http://backup-service:3000
# Cada cuántas horas se hace el respaldo automático
BACKUP_INTERVAL_HOURS=24
# Respaldos más viejos que esto se borran solos
BACKUP_RETENTION_DAYS=7
# true = hace un respaldo automático apenas arranca el servicio
BACKUP_ON_START=false
# Segunda llave del backup-service: exige este valor en la cabecera x-backup-token
# (web-admin lo envía). Opcional en desarrollo; OBLIGATORIA en producción.
# En producción: openssl rand -hex 32
BACKUP_API_TOKEN=cambia_este_valor
